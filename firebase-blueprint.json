{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "Personal settings and profile of the authenticated user",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 255 },
        "language": { "type": "string", "enum": ["bn", "banglish", "en"] },
        "timezone": { "type": "string", "maxLength": 50 },
        "ramadanTargetDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "quranDailyGoalPages": { "type": "number" },
        "notificationsEnabled": { "type": "boolean" },
        "reminderTimes": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["displayName", "timezone"]
    },
    "prayerLog": {
      "title": "PrayerLog",
      "description": "Daily 5 prayers status and Sunnah tracking",
      "type": "object",
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "fajr": { "type": "object" },
        "dhuhr": { "type": "object" },
        "asr": { "type": "object" },
        "maghrib": { "type": "object" },
        "isha": { "type": "object" },
        "tahajjud": { "type": "boolean" },
        "duha": { "type": "boolean" },
        "witr": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["date"]
    },
    "dailyDeedsLog": {
      "title": "DailyDeedsLog",
      "description": "Daily completed good deeds and checklist items",
      "type": "object",
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "completedDeedIds": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["date", "completedDeedIds"]
    },
    "fastingLog": {
      "title": "FastingLog",
      "description": "Ayyam al-Bid and voluntary/obligatory fasting logs",
      "type": "object",
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "hijriDateStr": { "type": "string" },
        "fastingType": { "type": "string" },
        "status": { "type": "string", "enum": ["planned", "completed", "missed", "exempt"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["date", "status"]
    },
    "quranLog": {
      "title": "QuranLog",
      "description": "Quran reading and memorization session logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "surahNumber": { "type": "number" },
        "surahName": { "type": "string" },
        "startAyah": { "type": "number" },
        "endAyah": { "type": "number" },
        "pagesCount": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "date"]
    },
    "characterReflection": {
      "title": "CharacterReflection",
      "description": "Daily Tazkiyah and Gheebah avoidance reflections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "avoidedGheebahIntention": { "type": "boolean" },
        "reflectionText": { "type": "string" },
        "soughtForgiveness": { "type": "boolean" },
        "angerControlled": { "type": "boolean" },
        "truthfulnessObserved": { "type": "boolean" },
        "kindnessShown": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "date"]
    },
    "ramadanLog": {
      "title": "RamadanLog",
      "description": "Ramadan 1448 AH daily fasting and spiritual preparation records",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "dayNumber": { "type": "number" },
        "fasted": { "type": "boolean" },
        "sehriRecorded": { "type": "boolean" },
        "iftarRecorded": { "type": "boolean" },
        "taraweehRakats": { "type": "number" },
        "charityGiven": { "type": "boolean" },
        "quranReadMinutes": { "type": "number" },
        "specialReflection": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["date"]
    },
    "customHabit": {
      "title": "CustomHabit",
      "description": "Personal custom Islamic habits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "frequency": { "type": "string" },
        "targetDays": { "type": "number" },
        "completedDates": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title"]
    }
  },
  "firestore": {
    "/users/{userId}/settings/profile": {
      "schema": "userProfile",
      "description": "User profile and personal settings"
    },
    "/users/{userId}/prayerLogs/{date}": {
      "schema": "prayerLog",
      "description": "Daily 5 prayers log"
    },
    "/users/{userId}/dailyLogs/{date}": {
      "schema": "dailyDeedsLog",
      "description": "Daily completed deeds checklist"
    },
    "/users/{userId}/fastingLogs/{date}": {
      "schema": "fastingLog",
      "description": "Fasting log and Ayyam al-Bid tracker"
    },
    "/users/{userId}/quranLogs/{logId}": {
      "schema": "quranLog",
      "description": "Quran reading records"
    },
    "/users/{userId}/characterReflections/{date}": {
      "schema": "characterReflection",
      "description": "Character and Gheebah reflection entries"
    },
    "/users/{userId}/ramadanLogs/{date}": {
      "schema": "ramadanLog",
      "description": "Ramadan records"
    },
    "/users/{userId}/customHabits/{habitId}": {
      "schema": "customHabit",
      "description": "User custom personal habits"
    }
  }
}
